# Copy this file to a new file named .env and edit the values.
# Local PostgreSQL (replace yourpassword with the password you set during install):
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/expense_splitter
# Hosted example (Neon / Supabase): paste the connection string they give you, e.g.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Set to false to start with an empty database (no sample "Goa Trip" group)
SEED_SAMPLE_DATA=true
